{
 "name": "ms3_w_gate",
 "version": "8.2",
 "date": "2026-11-16",
 "what": "W of the MS3 gate, documented for building it into FLASHIda: the probability that the MS3 of a planned target fragment shows at least one bond of that fragment. The model is W of model version 3 (w_ext_v3.json), unchanged.",
 "status": "a fixed version of the model and its documentation; no threshold is chosen or frozen, no gate is released, nothing is deployed",
 "for": "LC runs in the application mode Intact Protein; an MS3 of a b or y fragment of an HCD MS2 with at least two residues",
 "not_for": "peptide mode, direct infusion, other samples than E. coli: W is too high there (results/REPORT_v5.md, REPORT_v6.md)",
 "model": {
  "file": "w_ext_v3.json",
  "kind": "XGBoost gradient-boosted trees, objective binary:logistic",
  "xgboost_version_of_the_fit": "3.4.1",
  "trees": 84,
  "inputs": 36,
  "base_score": "4.1593963E-1",
  "output": "W = 1 / (1 + exp(-(sum of the leaf values + log(base_score / (1 - base_score)))))",
  "fitted_on": {
   "set": "development folds dev0-dev4 (E. coli LC, protein split)",
